+// Full paprium.pcm preload into DDR for Paprium_MiSTer (Pocket PPAD / Option D).
+//
+// Critical: do NOT use fpga_mem(). That helper masks to a 512 MiB window at
+// 0x20000000..0x3FFFFFFF; paprium.pcm is ~543 MiB. We mmap the physical base
+// 0x10000000 directly. mem= frees Linux from that range — it does not enlarge
+// fpga_mem.
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <ctype.h>
+
+#include "../../user_io.h"
+#include "../../file_io.h"
+#include "../../shmem.h"
+#include "../../menu.h"
+#include "paprium_pcm.h"
+
+#define PAPRIUM_PCM_BASE   0x10000000u
+#define PAPRIUM_PCM_MAX    0x22000000u
+#define PAPRIUM_PCM_EXPECT 569380864ull
+
+static void dirname_of(const char *path, char *out, size_t out_sz)
+{
+	snprintf(out, out_sz, "%s", path);
+	char *slash = strrchr(out, '/');
+	if (slash) *slash = 0;
+	else snprintf(out, out_sz, ".");
+}
+
+static int try_load(const char *pcm_path)
+{
+	fileTYPE f = {};
+	if (!FileOpen(&f, pcm_path)) return 0;
+
+	uint64_t size = (uint64_t)FileGetSize(&f);
+	printf("Paprium PCM: opening %s (%llu bytes)\n", pcm_path, (unsigned long long)size);
+
+	if (size < 0x1000 || size > PAPRIUM_PCM_MAX) {
+		printf("Paprium PCM: rejected size (need 4K..%u)\n", PAPRIUM_PCM_MAX);
+		FileClose(&f);
+		return 0;
+	}
+
+	uint8_t mag[4] = {};
+	if (FileReadAdv(&f, mag, 4) != 4 || memcmp(mag, "PPAD", 4) != 0) {
+		printf("Paprium PCM: bad magic (want PPAD)\n");
+		FileClose(&f);
+		return 0;
+	}
+	FileSeek(&f, 0, SEEK_SET);
+
+	// Direct physical map — identity, not fpga_mem(base).
+	uint8_t *mem = (uint8_t *)shmem_map(PAPRIUM_PCM_BASE, (uint32_t)size);
+	if (!mem) {
+		printf("Paprium PCM: mmap 0x%08X failed — check mem=256M memmap=768M$256M\n",
+		       PAPRIUM_PCM_BASE);
+		FileClose(&f);
+		return 0;
+	}
+
+	uint64_t done = 0;
+	uint8_t buf[256 * 1024];
+	while (done < size) {
+		uint32_t chunk = (uint32_t)((size - done > sizeof(buf)) ? sizeof(buf) : (size - done));
+		if (FileReadAdv(&f, buf, chunk) != (int)chunk) {
+			printf("Paprium PCM: short read @ %llu\n", (unsigned long long)done);
+			shmem_unmap(mem, (uint32_t)size);
+			FileClose(&f);
+			return 0;
+		}
+		memcpy(mem + done, buf, chunk);
+		done += chunk;
+		ProgressMessage("Paprium PCM", pcm_path, (uint32_t)done, (uint32_t)size);
+	}
+
+	int ok = (memcmp(mem, "PPAD", 4) == 0);
+	shmem_unmap(mem, (uint32_t)size);
+	FileClose(&f);
+
+	if (!ok) {
+		printf("Paprium PCM: DDR verify failed\n");
+		return 0;
+	}
+
+	if (size != PAPRIUM_PCM_EXPECT) {
+		printf("Paprium PCM: warning size %llu != shipping %llu\n",
+		       (unsigned long long)size, (unsigned long long)PAPRIUM_PCM_EXPECT);
+	}
+	printf("Paprium PCM: full preload OK @ 0x%08X (%llu bytes)\n",
+	       PAPRIUM_PCM_BASE, (unsigned long long)size);
+	return 1;
+}
+
+void paprium_pcm_init(const char *rom_path)
+{
+	if (!rom_path || !rom_path[0]) return;
+	if (strcasecmp(user_io_get_core_name(1), "MegaDrive")) return;
+
+	char dir[1024];
+	dirname_of(rom_path, dir, sizeof(dir));
+
+	char cand[2048];
+	const char *names[] = {
+		"paprium.pcm",
+		"Paprium.pcm",
+		"PAPRIUM.PCM",
+	};
+
+	// 1) Same directory as the ROM
+	for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		snprintf(cand, sizeof(cand), "%s/%s", dir, names[i]);
+		if (try_load(cand)) return;
+	}
+
+	// 2) Conventional games path
+	snprintf(cand, sizeof(cand),
+		 "/media/fat/games/MegaDrive/Paprium/paprium.pcm");
+	if (try_load(cand)) return;
+
+	printf("Paprium PCM: no paprium.pcm found next to ROM or under "
+	       "games/MegaDrive/Paprium/ — BGM silent (blob_ok=0)\n");
+}
