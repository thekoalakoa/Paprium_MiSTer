@@ -0,0 +1,8 @@
+#ifndef MEGADRIVE_PAPRIUM_PCM_H
+#define MEGADRIVE_PAPRIUM_PCM_H
+
+// One-shot full paprium.pcm → physical DDR @ PAPRIUM_PCM_BASE (0x10000000).
+// Requires bootargs mem=256M memmap=768M$256M and FB_ADDR @ 0x32000000.
+void paprium_pcm_init(const char *rom_path);
+
+#endif
